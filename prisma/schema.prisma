generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum PlanType {
  FREE
  PREMIUM
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum Journey {
  MEDICATION
  PREGNANCY
  VACCINATION
}

enum CarePlanType {
  MEDICATION
  PREGNANCY
  VACCINATION
}

enum CarePlanStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum CareEventStatus {
  PENDING
  DONE
  SKIPPED
  MISSED
}

enum ReminderChannel {
  EMAIL
  PUSH
}

enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum NotificationAttemptType {
  PUSH_PRIMARY
  FALLBACK_EMAIL
}

enum NotificationAttemptStatus {
  SENT
  FAILED
  SKIPPED
}

enum OutboxEventType {
  EMAIL_VERIFICATION
  MEDICATION_FALLBACK_EMAIL
  PASSWORD_RESET
  WELCOME_EMAIL
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ArticleCategory {
  GENERAL
  PREGNANCY
  BABY_CARE
  MEDICATION
  NUTRITION
  MENTAL_HEALTH
}

enum DraftStatus {
  IN_PROGRESS
  READY_FOR_REVIEW
  NEEDS_MANUAL_REVIEW
  CONFIRMED
  CANCELLED
}

enum DraftSource {
  TEXT
  AUDIO
}

// ─────────────────────────────────────────────
// Calendar Enums
// ─────────────────────────────────────────────

enum CalendarProvider {
  GOOGLE
}

enum CalendarSyncStatus {
  PENDING
  SYNCING
  SYNCED
  SYNC_FAILED
  CLEANUP_REQUIRED
  CLEANUP_RESOLVED
}

// ─────────────────────────────────────────────
// Person / Account separation — phase A
// ─────────────────────────────────────────────

enum PersonRole {
  OWNER
  CAREGIVER
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REVOKED
}

/// What happened to someone's access to a Person's health data. Append-only —
/// see PersonAccessEvent.
enum AccessAction {
  GRANTED
  ACCEPTED
  CLAIMED

  /// An owner removed someone else's access.
  REVOKED

  /// A member removed their own access. Distinct from REVOKED on purpose:
  /// "they took my access away" and "I walked away" are different facts about
  /// a consent relationship, and the ledger has to be able to tell them apart.
  LEFT

  TRANSFERRED
  ARCHIVED
  ERASED
}

/// How a Person came to exist. Provenance, like createdByUserId — set once at
/// creation and never changed. Entitlement stays *derived*: the first-baby
/// exemption is computed from this plus ordering, so there is no stored
/// "this one is free" flag that could drift from reality.
enum PersonOrigin {
  /// The account's own record, created at signup.
  SELF

  /// A baby born through the pregnancy journey.
  DELIVERY

  /// A baby added after birth, without a pregnancy recorded in Vitals.
  BABY_PROFILE

  /// Any other dependent.
  MANAGED
}

// ─────────────────────────────────────────────
// Billing
// ─────────────────────────────────────────────

enum PaymentProvider {
  /// No provider is integrated yet. Rows carrying this were created by an
  /// admin grant or a test, never by money changing hands.
  NONE
  PAYSTACK
  FLUTTERWAVE
}

enum SubscriptionStatus {
  /// Checkout started, first payment not confirmed. Grants nothing.
  INCOMPLETE

  ACTIVE

  /// Renewal failed. Still grants entitlement through the grace window —
  /// losing access to a dependent's records because a card expired is the
  /// wrong failure, and the account keeps them regardless.
  PAST_DUE

  /// Cancelled but paid up. Still grants until currentPeriodEnd.
  CANCELED

  /// Period elapsed. Grants nothing.
  EXPIRED
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  /// Recorded and deliberately not applied — a stale event, or one for a
  /// subscription we do not know about.
  IGNORED
  FAILED
}

enum PaymentTransactionType {
  CHARGE
  REFUND
  CHARGEBACK
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// Where an account erasure request has got to. Erasure is a state machine,
/// not an instant operation, because an account that is the sole OWNER of an
/// unclaimed Person cannot be erased without first resolving that Person.
enum ErasureStatus {
  REQUESTED
  BLOCKED
  READY
  EXECUTED
  CANCELLED
}

// ─────────────────────────────────────────────
// Auth & User
// ─────────────────────────────────────────────

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  firstName           String?
  lastName            String?
  passwordHash        String
  role                Role                 @default(USER)
  planType            PlanType             @default(FREE)
  emailVerified       Boolean              @default(false)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]

  // Entitlement — two independent axes, both account-level.
  // Managed capacity is dependents this account created and still owns
  // unclaimed; connection capacity is adults with their own account who have
  // linked to it. A self-Person has ownerUserId set and consumes neither, so
  // the free tier at 0/0 means "self only" rather than "no access".
  // Ceiling on new only: an account that falls below its limit after a
  // downgrade keeps every Person it already has.
  managedPersonLimit Int @default(0)
  connectionLimit    Int @default(0)

  /// Erasure is field-level destruction plus a tombstone, not a row delete.
  /// The row survives carrying no personal data, so Restrict on the clinical
  /// foreign keys never has to be defeated and other people's history keeps
  /// its shape.
  ///
  /// The email column stays NOT NULL and is overwritten with an unusable
  /// sentinel rather than set to NULL — making it nullable would change
  /// User.email to `string | null` across the whole auth layer for no gain.
  /// The original address is destroyed either way, and freed for re-signup
  /// because the unique value changes.
  erasedAt             DateTime?
  erasureStatus        ErasureStatus?
  erasureBlockedReason String?

  // Relations
  profile                 Profile?
  carePlans               CarePlan[]
  activityLogs            ActivityLog[]
  symptomLogs             SymptomLog[]
  drugDetections          DrugDetection[]
  moodLogs                MoodLog[]
  dailyUsage              DailyUsage[]
  pushSubscriptions       PushSubscription[]
  pushTokens              PushToken[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  outboxEvents            OutboxEvent[]
  medicationDrafts        MedicationDraft[]

  calendarIntegrations CalendarIntegration[]
  calendarEventLinks   CalendarEventLink[]

  subscriptions       Subscription[]
  paymentTransactions PaymentTransaction[]

  // Person separation — phase A. No data is written to these yet.
  ownedPersons      Person[]
  personMemberships PersonMembership[]
  actedActivityLogs ActivityLog[]      @relation("ActivityActor")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  /// Hash of the token that superseded this one during rotation. Lets a
  /// concurrent refresh (two browser tabs sharing one cookie) be recognised as
  /// a benign race rather than token theft.
  replacedByTokenHash String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────
// Profile
// ─────────────────────────────────────────────

model Profile {
  id     String @id @default(uuid())
  userId String @unique

  // Basic
  gender          Gender?
  country         String?
  city            String?
  phoneNumber     String?
  dateOfBirth     DateTime?
  profilePhotoUrl String?

  // Medical
  bloodGroup         String?
  genotype           String?
  heightCm           Float?
  weightKg           Float?
  allergies          String[]
  existingConditions String[]
  currentMedications String[]
  disabilities       String[]
  smokingStatus      String?
  alcoholUse         String?

  // Existing
  timezone                String   @default("Africa/Lagos")
  notificationPreferences Json     @default("{}")
  selectedJourney         Journey?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ─────────────────────────────────────────────
// Person / Account separation — phase A (additive, no data written)
//
// A Person is the human whose health is recorded. It may exist with no account
// at all — a baby, or a parent whose child manages their care. An account
// reaches a Person only through PersonMembership, never by owning the clinical
// rows.
//
// Phase A creates the structures and leaves them empty. Every clinical model
// keeps its userId untouched and still authoritative; the nullable personId
// columns added below are written in a later phase.
// ─────────────────────────────────────────────

model Person {
  id          String    @id @default(uuid())
  displayName String
  dateOfBirth DateTime?
  gender      Gender?

  /// NULL means unclaimed. This single column is what separates a *managed*
  /// Person (a dependent, consuming a managed slot on the account that owns
  /// the OWNER membership) from a *connected* Person (an adult with their own
  /// account, consuming a connection instead). Deriving it means the two can
  /// never drift apart, and a claim frees the managed slot with no counter to
  /// decrement.
  ownerUserId String?
  claimedAt   DateTime?

  /// Provenance only — never read for authorization, and deliberately not a
  /// foreign key so that erasing an account can null it without touching the
  /// health records of anyone else.
  createdByUserId String?

  /// How this Person came to exist. Immutable.
  origin PersonOrigin @default(MANAGED)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  memberships   PersonMembership[]
  healthProfile PersonHealthProfile?

  carePlans          CarePlan[]
  symptomLogs        SymptomLog[]
  moodLogs           MoodLog[]
  drugDetections     DrugDetection[]
  medicationDrafts   MedicationDraft[]
  activityLogs       ActivityLog[]
  personAccessEvents PersonAccessEvent[]

  /// "Exactly one self-Person per account" as a database constraint rather
  /// than something a verification query notices afterwards. Postgres treats
  /// NULLs as distinct in a unique index, so any number of *unclaimed* Persons
  /// coexist while an account can own at most one — which is precisely the
  /// rule. A partial index (WHERE "ownerUserId" IS NOT NULL) would be
  /// equivalent but is not expressible in the Prisma schema, and raw SQL for
  /// it would read as drift on the next migrate.
  @@unique([ownerUserId])
  @@index([createdByUserId])
  @@index([origin, createdAt])
  @@map("persons")
}

model PersonMembership {
  id       String           @id @default(uuid())
  personId String
  userId   String
  role     PersonRole       @default(VIEWER)
  status   MembershipStatus @default(INVITED)

  /// Modelled now, not built. Delivery is account-scoped: for a managed Person
  /// the managing account receives the reminder. Connected-account routing is
  /// out of scope, so only the managing OWNER is ever set true for now.
  receivesNotifications Boolean @default(false)

  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([personId, userId])
  @@index([userId, status])
  @@index([personId, status, receivesNotifications])
  @@map("person_memberships")
}

/// The clinical attributes that Profile currently pins to an account. Phase A
/// creates this table empty; the columns on Profile stay exactly where they
/// are and remain the source of truth until the compatibility window closes.
model PersonHealthProfile {
  id       String @id @default(uuid())
  personId String @unique

  bloodGroup         String?
  genotype           String?
  heightCm           Float?
  weightKg           Float?
  allergies          String[]
  existingConditions String[]
  currentMedications String[]
  disabilities       String[]
  smokingStatus      String?
  alcoholUse         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("person_health_profiles")
}

/// The consent ledger. Append-only: rows are inserted, never updated or
/// deleted.
///
/// PersonMembership.status records the *current* state and overwrites itself
/// on every transition, so it cannot answer "who was granted what, by whom,
/// when, and when was it revoked". Revocation has to be recorded rather than
/// erased, and ActivityLog is a user-facing feed, not an access log.
///
/// Erasing an account nulls the user references here but keeps the rows: a
/// person's record of who had access to their health data is that person's
/// data, not solely the erased account's.
model PersonAccessEvent {
  id       String @id @default(uuid())
  personId String

  /// The account gaining or losing access.
  subjectUserId String?

  /// Who performed the action. Null for system actions and after erasure.
  actorUserId String?

  action AccessAction
  role   PersonRole?

  /// Why this was permitted: 'owner-invite', 'self-claim', 'handoff',
  /// 'erasure', 'backfill'.
  basis String

  metadata   Json     @default("{}")
  occurredAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([personId, occurredAt])
  @@index([subjectUserId, occurredAt])
  @@map("person_access_events")
}

// ─────────────────────────────────────────────
// Billing — subscriptions, prices and money movements
// ─────────────────────────────────────────────

/// A price someone can buy a tier at.
///
/// A row here is immutable once anyone may have bought it. Repricing means
/// inserting a new row and setting `active = false` on the old one — never
/// editing `amountMinor`. That is what lets an existing subscriber keep the
/// price they signed up at: their subscription points at this row, and the row
/// never changes underneath them.
///
/// Seeded from billing.config.ts, which stays the definition of what is
/// *offered*. This table is what a subscription can still resolve years later,
/// after the config has moved on.
model Price {
  /// Stable, human-readable, and identical to the config entry's id.
  id String @id

  tier          PlanType
  label         String
  amountMinor   Int
  currency      String   @default("NGN")
  interval      String
  intervalCount Int      @default(1)

  /// Offered for purchase. Retired prices stay resolvable for their holders.
  active Boolean @default(true)

  /// Not yet validated against real users.
  provisional Boolean @default(true)

  /// The provider's identifier for this price, once one exists. Null until a
  /// provider is wired, and different per provider.
  providerPriceId String?
  provider        PaymentProvider @default(NONE)

  createdAt DateTime @default(now())

  subscriptions Subscription[]

  @@index([tier, active])
  @@map("prices")
}

/// What an account is paying for.
///
/// Account-scoped, never person-scoped: entitlement is measured per login, and
/// a Person must never become something you can buy more of by adding people.
model Subscription {
  id      String @id @default(uuid())
  userId  String
  priceId String

  status   SubscriptionStatus @default(INCOMPLETE)
  provider PaymentProvider    @default(NONE)

  /// The provider's own identifier. Unique so a webhook can find exactly one
  /// row, and nullable because a subscription exists locally from the moment
  /// checkout starts — before the provider has named it.
  providerSubscriptionId String? @unique
  /// The provider's customer handle. Kept separately so a refund arriving
  /// after erasure can still be attributed without a user row.
  providerCustomerRef String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  /// When the renewal first failed. The grace window runs from here, not from
  /// currentPeriodEnd — a charge can fail mid-period, and "you have until the
  /// period ends" would give one subscriber weeks and another minutes.
  pastDueSince DateTime?

  /// The provider's timestamp for the most recent event applied to this row.
  /// Events older than this are stale and must not overwrite newer state:
  /// webhooks arrive out of order, and arrival order is not event order.
  providerUpdatedAt DateTime?

  lastReconciledAt DateTime?

  /// Cancelled by the subscriber but still paid up until periodEnd.
  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?
  endedAt           DateTime?

  /// Set when cancellation was requested but the provider has not confirmed —
  /// an account erasing itself must not be blocked by a provider outage, so
  /// the request is recorded and reconciliation retries it later.
  cancellationRequestedAt DateTime?
  cancellationConfirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Restrict, like every other account-owned record: a subscription is a
  /// financial fact and must outlive an attempt to delete the account.
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  price Price @relation(fields: [priceId], references: [id], onDelete: Restrict)

  transactions PaymentTransaction[]

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// Money that moved, or tried to.
///
/// Both `userId` and `subscriptionId` are nullable, and that is the point: a
/// refund or chargeback can arrive after the account has been erased, and it
/// still has to land somewhere. Erasure nulls the user link and keeps the row,
/// because a financial record has its own basis for retention that is not the
/// subject's account. `providerReference` and `providerCustomerRef` carry no
/// personal data and are what reconciliation matches on.
model PaymentTransaction {
  id String @id @default(uuid())

  userId         String?
  subscriptionId String?

  provider PaymentProvider
  /// The provider's id for this movement. Unique, so replaying a webhook
  /// cannot record the same payment twice.
  providerReference   String  @unique
  providerCustomerRef String?

  type   PaymentTransactionType
  status PaymentTransactionStatus @default(PENDING)

  amountMinor Int
  currency    String @default("NGN")

  /// What the provider sent, kept verbatim for disputes and reconciliation.
  payload Json @default("{}")

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([subscriptionId, occurredAt])
  @@index([providerCustomerRef])
  @@map("payment_transactions")
}

/// An inbound provider event.
///
/// Written before anything is acted on, so the HTTP response can be immediate
/// and the work durable — the same shape as the outbox, pointed inward. A
/// provider that does not get a fast 200 will retry, and retries are exactly
/// what the uniqueness below makes harmless.
model BillingWebhookEvent {
  id       String          @id @default(uuid())
  provider PaymentProvider

  /// The provider's own event id. Unique per provider, which is what makes a
  /// replay a no-op: the second insert loses and nothing is applied twice.
  /// Keyed on the id rather than the payload, because a provider may resend a
  /// byte-identical body or a re-serialised one, and neither should matter.
  providerEventId String

  type String

  /// When the provider says it happened, not when it reached us.
  occurredAt DateTime

  payload Json @default("{}")

  status      WebhookEventStatus @default(PENDING)
  receivedAt  DateTime           @default(now())
  processedAt DateTime?
  retryCount  Int                @default(0)
  error       String?

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@map("billing_webhook_events")
}

// ─────────────────────────────────────────────
// Care Engine
// ─────────────────────────────────────────────

model CarePlan {
  id        String         @id @default(uuid())
  userId    String
  type      CarePlanType
  title     String
  status    CarePlanStatus @default(ACTIVE)
  metadata  Json           @default("{}")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  /// Phase A: nullable and unwritten. userId above remains authoritative.
  /// CareEvent, Reminder, NotificationAttempt, Medication and PregnancyProfile
  /// reach the subject transitively through this row and need no column.
  personId String?

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  person           Person?           @relation(fields: [personId], references: [id], onDelete: Restrict)
  careEvents       CareEvent[]
  medication       Medication?
  pregnancyProfile PregnancyProfile?

  @@index([userId, status])
  @@index([userId, type, status])
  @@index([personId, status])
  @@map("care_plans")
}

model CareEvent {
  id           String          @id @default(uuid())
  carePlanId   String
  eventType    String
  title        String
  description  String?
  scheduledFor DateTime
  status       CareEventStatus @default(PENDING)
  metadata     Json            @default("{}")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  carePlan  CarePlan   @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  calendarLinks CalendarEventLink[]

  @@index([carePlanId, status, scheduledFor])
  @@index([status, scheduledFor])
  @@index([scheduledFor])
  @@map("care_events")
}

model Reminder {
  id            String          @id @default(uuid())
  careEventId   String
  channel       ReminderChannel
  sendAt        DateTime
  status        ReminderStatus  @default(PENDING)
  retryCount    Int             @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  processedAt   DateTime?
  errorMessage  String?

  careEvent            CareEvent             @relation(fields: [careEventId], references: [id], onDelete: Cascade)
  notificationAttempts NotificationAttempt[]

  @@index([status, sendAt])
  @@map("reminders")
}

model NotificationAttempt {
  id             String                    @id @default(uuid())
  reminderId     String
  channel        ReminderChannel
  type           NotificationAttemptType
  status         NotificationAttemptStatus
  idempotencyKey String                    @unique
  attemptedAt    DateTime                  @default(now())
  errorMessage   String?

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId])
  @@map("notification_attempts")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  /// Two columns because this table is genuinely two things: the dashboard
  /// reads it as "what happened to this person", and writers record "who did
  /// it". A caregiver acting for a dependent must appear in the dependent's
  /// history, attributed to the caregiver. Both nullable and unwritten in
  /// phase A. This is not an access log — consent lives elsewhere.
  personId    String?
  actorUserId String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  person Person? @relation(fields: [personId], references: [id], onDelete: Restrict)
  actor  User?   @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([personId, createdAt])
  @@map("activity_logs")
}

// ─────────────────────────────────────────────
// Outbox
// ─────────────────────────────────────────────

model OutboxEvent {
  id            String            @id @default(uuid())
  userId        String?
  type          OutboxEventType
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  retryCount    Int               @default(0)
  lastAttemptAt DateTime?
  processedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("outbox_events")
}

// ─────────────────────────────────────────────
// Medications
// ─────────────────────────────────────────────

model Medication {
  id           String    @id @default(uuid())
  carePlanId   String    @unique
  name         String
  dosage       String
  frequency    String
  startDate    DateTime
  endDate      DateTime?
  instructions String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  carePlan CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)

  @@map("medications")
}

// ─────────────────────────────────────────────
// AI Medications
// ─────────────────────────────────────────────

model MedicationDraft {
  id            String      @id @default(uuid())
  userId        String
  extractedData Json        @default("{}")
  missingFields String[]    @default([])
  turnCount     Int         @default(1)
  status        DraftStatus @default(IN_PROGRESS)
  confidence    Float?
  source        DraftSource @default(TEXT)
  transcript    String?
  lastQuestion  String?
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  /// Phase A: nullable and unwritten.
  personId String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  person Person? @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([status])
  @@index([expiresAt])
  @@index([personId])
  @@map("medication_drafts")
}

