// ─────────────────────────────────────────────
// Calendar
// ─────────────────────────────────────────────

model CalendarIntegration {
  id           String           @id @default(uuid())
  userId       String
  provider     CalendarProvider @default(GOOGLE)
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  accountEmail String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("calendar_integrations")
}

model CalendarEventLink {
  id                String             @id @default(uuid())
  userId            String
  careEventId       String
  provider          CalendarProvider   @default(GOOGLE)
  externalEventId   String?
  syncStatus        CalendarSyncStatus @default(PENDING)
  lastSyncAttemptAt DateTime?
  lastSyncError     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  careEvent CareEvent @relation(fields: [careEventId], references: [id], onDelete: Cascade)

  /// Widened to include userId. One link per event per provider would allow
  /// only a single account to sync a given care event; once two accounts can
  /// see one Person, each needs its own link row, its own external event and
  /// its own sync lifecycle, because they hold different OAuth grants.
  /// Widening now avoids rebuilding this index later under load.
  @@unique([careEventId, provider, userId])
  @@index([userId, syncStatus])
  @@index([careEventId, syncStatus])
  @@map("calendar_event_links")
}
