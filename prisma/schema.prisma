// ─────────────────────────────────────────────
// Articles
// ─────────────────────────────────────────────

model Article {
  id          String          @id @default(uuid())
  title       String
  slug        String          @unique
  excerpt     String
  content     String
  imageUrl    String?
  category    ArticleCategory @default(GENERAL)
  isPublished Boolean         @default(false)
