# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ─────────────────────────────────────────────
# Database (use the pooled URL at runtime and the direct URL for migrations)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/vitals?sslmode=require"
DIRECT_URL="postgresql://user:password@host/vitals?sslmode=require"

# ─────────────────────────────────────────────
# Redis (Upstash)
# ─────────────────────────────────────────────
UPSTASH_REDIS_URL="rediss://:password@host:6380"
REDIS_HOST="host"
REDIS_PORT=6380
REDIS_PASSWORD="password"
REDIS_TLS=true

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET="your-access-secret-min-32-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─────────────────────────────────────────────
# Email (Brevo HTTP API)
# ─────────────────────────────────────────────
BREVO_API_KEY="your-brevo-api-key"
BREVO_FROM_EMAIL="noreply@vitals.health"
BREVO_FROM_NAME="Vitals"

# ─────────────────────────────────────────────
# App URLs
# ─────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"
API_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
CORS_ORIGIN="http://localhost:5173"

# ─────────────────────────────────────────────
# AI (Gemini)
# ─────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"

# ─────────────────────────────────────────────
# Storage (Cloudinary)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─────────────────────────────────────────────
# Firebase FCM (Push Notifications)
# ─────────────────────────────────────────────
# Backend — Firebase Admin SDK credentials (from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com"
# Paste the full private key including -----BEGIN/END----- lines. Keep \n as literal characters.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Frontend — VAPID public key from Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
# Used by the frontend Firebase SDK to generate FCM tokens. NOT used for server-side sending.
VAPID_PUBLIC_KEY="your-vapid-public-key-from-firebase-console"

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─────────────────────────────────────────────
# AI Quotas
# ─────────────────────────────────────────────
FREE_SYMPTOM_CHECKS_PER_DAY=3
FREE_DRUG_DETECTIONS_PER_DAY=3
PREMIUM_SYMPTOM_CHECKS_PER_DAY=20
PREMIUM_DRUG_DETECTIONS_PER_DAY=20

# ─────────────────────────────────────────────
# Billing (Paystack)
# ─────────────────────────────────────────────
# Optional. The adapter only registers when a key is present, so leaving this
# blank simply means no payment provider is configured: checkout refuses with
# a clear message and nothing else changes. Use a test key (sk_test_…) —
# a live key outside NODE_ENV=production is refused at start-up.
PAYSTACK_SECRET_KEY="sk_test_your-paystack-test-key"
PAYSTACK_BASE_URL="https://api.paystack.co"

# How many times a billing webhook event is attempted before it is
# dead-lettered — kept, logged loudly, and never retried automatically.
BILLING_EVENT_MAX_ATTEMPTS=5

# ─────────────────────────────────────────────
# Reminder settings
# ─────────────────────────────────────────────
ADHERENCE_CHECK_DELAY_MS=1800000
MISSED_WINDOW_MS=7200000

# ─────────────────────────────────────────────
# Verification token
# ─────────────────────────────────────────────
EMAIL_VERIFICATION_TOKEN_EXPIRES_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRES_HOURS=1

# Google Calendar OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/calendar/google/callback"
